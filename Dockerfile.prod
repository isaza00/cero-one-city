# Production image: engine + server + built frontend served from one origin.
# Used by Railway/Fly/Render; dev uses server/Dockerfile via docker-compose.

FROM node:22-slim AS webbuild
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm install
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN pip install --no-cache-dir uv
WORKDIR /srv
COPY engine/ /srv/engine/
COPY server/ /srv/server/
RUN uv pip install --system -e /srv/engine -e /srv/server
COPY --from=webbuild /web/dist /srv/web/dist
WORKDIR /srv/server
EXPOSE 8000
# api service command (the worker service overrides with: arq app.worker.WorkerSettings)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
