# Copy to .env if you need overrides (the dev docker-compose already sets sane
# values). This file documents everything production needs.
DATABASE_URL=postgresql+asyncpg://cero:cero@localhost:5432/cero
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-long-random
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts provider API keys.
MASTER_KEY=ZGV2LW1hc3Rlci1rZXktMzItYnl0ZXMtYmFzZTY0PT0=
ENV=dev                      # prod enables strict auth rate-limiting

ADMIN_EMAIL=admin@cero.local
ADMIN_PASSWORD=admin-dev-password

# Practice matches (paid by the game) and house agents.
# Empty keys => house/practice agents play as free scripted bots (dev-friendly).
PRACTICE_PROVIDER=anthropic
PRACTICE_MODEL=claude-haiku-4-5
PRACTICE_API_KEY=
PRACTICE_DAILY_BUDGET_USD=10
HOUSE_PROVIDER=anthropic
HOUSE_MODEL_CHEAP=claude-haiku-4-5
HOUSE_MODEL_STRONG=claude-sonnet-5
HOUSE_API_KEY=
HOUSE_DAILY_BUDGET_USD=5

# Live-match pacing: minimum wall-clock seconds per turn (0 for dev/tests,
# 2 recommended in production so spectating is watchable).
MIN_TURN_SECONDS=0
